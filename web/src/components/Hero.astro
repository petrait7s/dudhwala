---
import Bi from './Bi.astro';
import Art from './Art.astro';
import MilkSplash from './MilkSplash.astro';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
// a real milk-wave clip dropped into public/milk/ (wave.webp or wave.gif) replaces the drawn splash; see scripts/milk-convert.sh
const clip = ['wave.webp', 'wave.gif'].find((f) => existsSync(join(process.cwd(), 'public', 'milk', f)));
import hero from '../data/hero.json';
interface Slide { src: string; fx?: number; fy?: number; altBn?: string; altEn?: string }
const slides = hero as Slide[];
---
<section class={`heroband${slides.length ? ' hasphotos' : ''}${clip ? ' hasclip' : ''}`} data-hero style={slides.length ? 'min-height:min(78vh,620px);display:flex;align-items:flex-end' : ''}>
  {slides.length > 0 && (
    <div class="slides" data-slides>
      {slides.map((s, i) => (
        <div class={`slide${i === 0 ? ' on' : ''}`} style={`--fx:${s.fx ?? 50}%;--fy:${s.fy ?? 50}%`}>
          <img src={`${s.src}-800.webp`} srcset={`${s.src}-800.webp 800w, ${s.src}-1400.webp 1400w`} sizes="100vw" alt={s.altEn ?? ''}
            width="1400" height="933" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} decoding={i === 0 ? 'sync' : 'async'} />
        </div>
      ))}
    </div>
  )}
  {slides.length > 0 && <div class="shade"></div>}
  <div class="wrap" style="width:100%">
    <div class="in" data-copy>
      <div>
        <p class="eyebrow"><i aria-hidden="true"></i>Serving Purity</p>
        <h1><Bi bn="সিলেটের নিজস্ব দুগ্ধজাত পণ্য," en="Sylhet's own dairy products," /><br /><em><Bi bn="আপনার দোরগোড়ায়" en="at your doorstep" /></em></h1>
        <p class="lead"><Bi bn="গরুর খাঁটি কাঁচা দুধ, দই, মিষ্টি, ঘি এবং বেকারি পণ্য — অনলাইনে অর্ডার করুন, পছন্দের সময়ে ডেলিভারি নিন।" en="Pure cow's milk, doi, sweets, ghee and bakery products. Order online and get delivery at your chosen time." /></p>
        <div class="hero-cta">
          <a class="btn light hbtn" href="#products"><Bi bn="পণ্য দেখুন" en="Browse products" /><svg class="btn-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          <a class="btn ghostw hbtn" href="/showroom"><Bi k="showroom" /></a>
        </div>
        <ul class="hero-trust">
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg><Bi bn="খাঁটি দুধ থেকে তৈরি" en="Made from pure milk" /></li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg><Bi bn="২৪ ঘণ্টার মধ্যে ডেলিভারি" en="Delivery within 24 hours" /></li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg><Bi bn="যেকোনো শাখা থেকে পিকআপ" en="Pickup at any branch" /></li>
        </ul>
      </div>
      <div class="hstage" aria-hidden="true">
        <div class="logocard"><img src="/logo.png" alt="" width="450" height="240" /></div>
        <span class="orb o1" style="--a1:#f2b8c6;--a2:#fde4ea;--a3:#c9788f;--hi:#fff"><Art kind="sweet" /></span>
        <span class="orb o2" style="--a1:#8fe3ff;--a2:#e4f7ff;--a3:#2b9fc9;--hi:#fff"><Art kind="cup" /></span>
        <span class="orb o3" style="--a1:#d9962b;--a2:#f3c97a;--a3:#a8661a;--hi:#fff"><Art kind="cookie" /></span>
      </div>
    </div>
  </div>
</section>
<div class={`msplash up${clip ? ' has-clip' : ''}`} data-milk-host><MilkSplash kind="rise" />{clip && <div class="milkrow" aria-hidden="true"><img src={`/milk/${clip}`} alt="" decoding="async" width="1097" height="545" /></div>}</div>
<script>import '../scripts/hero';</script>
