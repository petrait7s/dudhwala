---
import Bi from './Bi.astro';
---
<div class="zonebar" data-zonebar>
  <div class="wrap zb">
    <a class="zb-about" href="/about"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.1"/></svg><Bi bn="আমাদের সম্পর্কে" en="About us" /></a>
    <div class="zb-r">
    <span class="zb-l"><Bi bn="ডেলিভারি জোন:" en="Delivery zone:" /></span>
    <div class="seg-group" role="group" aria-label="Delivery zone">
      <button type="button" class="seg" data-z="IN_CITY"><Bi bn="ইন সিলেট" en="In Sylhet" /></button>
      <button type="button" class="seg" data-z="OUTER_CITY"><Bi bn="আউটার সিলেট" en="Outer Sylhet" /></button>
    </div>
    <a class="zb-act" href="/showroom"><Bi k="showroom" /></a>
    <span class="zb-eta" data-eta></span>
    <span class="zchip" data-status role="status"></span>
    <a class="zchip warn" data-warn href="/cart" hidden role="alert"></a>
    </div>
  </div>
</div>
<script>import '../scripts/zonebar';</script>
