---
import Bi from './Bi.astro';
import ProductCard from './ProductCard.astro';
import { products, categories } from '../lib/catalogue';
---
<section id="products" style="scroll-margin-top:7rem">
  <div class="cat-head">
    <h2 class="h-dots" style="margin:0"><Bi k="allProducts" /></h2>
    <span class="muted" id="count" role="status"></span>
  </div>
  <p id="zonenote" class="notice" hidden></p>
  <nav class="cat-bar" aria-label="Category">
    <button class="pill" type="button" data-chip="" aria-pressed="true"><Bi k="allProducts" /> <b data-n=""></b></button>
    {categories.map((c) => <button class="pill" type="button" data-chip={c.slug} aria-pressed="false"><Bi bn={c.nameBn} en={c.nameEn} /> <b data-n={c.slug}></b></button>)}
  </nav>
  <div class="tools2">
    <input id="q" type="search" style="max-width:340px" data-ph-bn="পণ্য খুঁজুন (বাংলা বা English)" data-ph-en="Search products (Bangla or English)" placeholder="পণ্য খুঁজুন" aria-label="Search" />
    <select id="sort" aria-label="Sort">
      <option value="name">নাম / Name</option>
      <option value="low">দাম কম → বেশি / Price low → high</option>
      <option value="high">দাম বেশি → কম / Price high → low</option>
    </select>
  </div>
  <div class="grid" id="grid">
    {products.map((p) => <ProductCard slug={p.id} nameBn={p.nameBn} nameEn={p.nameEn} category={p.category} outer={p.outerCity ? p.outerCity.toUpperCase() : null} kind={p.kind} />)}
  </div>
  <p id="none" class="notice" hidden><Bi k="noResults" /></p>
</section>
<script>import '../scripts/shop';</script>
