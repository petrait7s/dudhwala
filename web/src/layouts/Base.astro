---
import '../styles/global.css';
import Bi from '../components/Bi.astro';
import Icons from '../components/Icons.astro';
import ZoneBar from '../components/ZoneBar.astro';
import site from '../data/site.json';
import { products, categories } from '../lib/catalogue';
const suggest = JSON.stringify(products.map((p) => { const c = categories.find((x) => x.slug === p.category); return { id: p.id, bn: p.nameBn, en: p.nameEn, cbn: c?.nameBn ?? '', cen: c?.nameEn ?? '' }; })).replace(/</g, '\\u003c');
interface Props { titleBn: string; titleEn: string; descBn?: string; descEn?: string; nav?: 'home' | 'shop' | 'info' | 'track' | 'cart' | ''; buybar?: boolean; zonebar?: boolean }
const { titleBn, titleEn, descBn = 'দুধওয়ালা: সিলেটের দুগ্ধজাত মিষ্টি, দই ও বেকারি।', descEn = 'Dudhwala: dairy sweets, doi and bakery from Sylhet.', nav = '', buybar = false, zonebar = true } = Astro.props;
const path = Astro.url.pathname;
const cur = (n: string) => (nav === n ? 'page' : undefined);
const url = new URL(path, Astro.site).toString();
---
<!doctype html>
<html lang="bn" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <title>{titleBn} | {titleEn} · {site.nameEn}</title>
  <meta name="description" content={descBn + ' ' + descEn} />
  <link rel="canonical" href={url} />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="icon" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/icons/icon-192.png" />
  <meta name="theme-color" content="#1d2672" />
  <meta property="og:title" content={`${titleBn} | ${titleEn}`} />
  <meta property="og:image" content="/logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&family=Tiro+Bangla&display=swap" />
  <script is:inline>
    (function () {
      try {
        var l = localStorage.getItem('dw_lang'); document.documentElement.lang = l === 'en' ? 'en' : 'bn';
        var t = localStorage.getItem('dw_theme');
        if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      } catch (e) {}
    })();
  </script>
</head>
<body data-has-buybar={buybar ? '1' : undefined}>
  <a class="sr" href="#main">Skip to content</a>
  <header class="top">
    <div class="wrap hdr">
      <a class="brand" href="/" aria-label={site.nameEn}><img src="/logo.png" width="96" height="51" alt={site.nameEn} /></a>
      <form class="hsearch" action="/shop" method="get" role="search">
        <input type="search" name="q" autocomplete="off" aria-label="Search" data-ph-bn="পণ্য খুঁজুন (বাংলা বা English)" data-ph-en="Search products (Bangla or English)" placeholder="পণ্য খুঁজুন" />
        <button type="submit" aria-label="Search"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg></button>
      </form>
      <div class="tools">
        <a class="tool msearch" href="/shop?focus=1" aria-label="Search"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg></a>
        <button class="tool" id="lang" type="button" aria-label="Language / ভাষা"><span class="bn">EN</span><span class="en">বাং</span></button>
        <button class="tool" id="theme" type="button" aria-label="Theme"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/></svg></button>
        <a class="tool" href="/track" aria-label="Track order"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c1-4 4-6 8-6s7 2 8 6"/></svg></a>
        <a class="tool cartlink" href="/cart" aria-label="Cart"><Icons name="cart" /><span class="badge" data-cartcount hidden>0</span></a>
      </div>
    </div>
  </header>
  {zonebar ? <ZoneBar /> : <slot name="band" />}

  <main id="main"><slot /></main>

  <footer class="ft">
    <svg class="wave flip" viewBox="0 0 1440 28" preserveAspectRatio="none" aria-hidden="true"><path fill="currentColor" d="M0 0h1440v10c-120 12-240 18-360 12S840 4 720 6 480 24 360 24 120 14 0 10Z" /></svg>
    <div class="fbody">
    <div class="wrap cols">
      <div>
        <strong style="color:#fff;font-size:1.1rem"><Bi bn={site.nameBn} en={site.nameEn} /></strong>
        <p><Bi bn={`${site.taglineBn} · ${site.city.bn}`} en={`${site.taglineEn} · ${site.city.en}`} /></p>
        <p><Bi bn="সিলেটে আমাদের একাধিক শাখা আছে। যেকোনো শাখা থেকে পিকআপ বা শোরুম অর্ডার নেওয়া যায়।" en="We have several branches in Sylhet. Pickup and showroom orders can be collected at any of them." /></p>
      </div>
      <ul>
        <li><a href="/shop"><Bi k="shop" /></a></li>
        <li><a href="/showroom"><Bi k="showroom" /></a></li>
        <li><a href="/track"><Bi k="track" /></a></li>
        <li><a href="/cart"><Bi k="cart" /></a></li>
      </ul>
      <ul>
        <li><a href="/about"><Bi k="info" /></a></li>
        <li><a href="/contact"><Bi k="contact" /></a></li>
        <li hidden data-pages-end></li>
      </ul>
    </div>
    <div class="wrap ft-bottom">
      <span class="petra"><a href="https://www.petrait.site" target="_blank" rel="noopener" aria-label="PETRA"><img src="/petra-logo.png" width="36" height="36" alt="PETRA" /></a><span><Bi bn="ডেভেলপ ও ডিজাইন: PETRA" en="Developed and designed by PETRA" /><b>Built On Trust</b></span></span>
      <span class="copy">© {new Date().getFullYear()} {site.nameEn}</span>
    </div>
    </div>
  </footer>

  <nav class={`tabs${buybar ? ' hide' : ''}`} aria-label="Tabs">
    <a href="/" aria-current={cur('home')}><Icons name="home" /><Bi k="home" /></a>
    <a href="/shop" aria-current={cur('shop')}><Icons name="shop" /><Bi k="shop" /></a>
    <a href="/about" aria-current={cur('info')}><Icons name="info" /><Bi k="info" /></a>
    <a href="/track" aria-current={cur('track')}><Icons name="track" /><Bi k="track" /></a>
    <a href="/cart" aria-current={cur('cart')}><Icons name="cart" /><Bi k="cart" /><span class="badge" data-cartcount hidden>0</span></a>
  </nav>
  <script type="application/json" id="dw-suggest" set:html={suggest} />
  <script>import '../scripts/app';import '../scripts/suggest';</script>
</body>
</html>
