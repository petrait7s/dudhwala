---
import Base from '../../layouts/Base.astro';
import Bi from '../../components/Bi.astro';
import pages from '../../data/pages.json';
type P = { slug: string; titleBn: string; titleEn?: string; bodyBn: string; bodyEn?: string };
export function getStaticPaths() { return (pages as P[]).map((p) => ({ params: { slug: p.slug }, props: { p } })); }
const { p } = Astro.props as { p: P };
const split = (t: string) => t.split(/\n{2,}/);
const bn = split(p.bodyBn);
const en = split(p.bodyEn ?? p.bodyBn);
---
<Base titleBn={p.titleBn} titleEn={p.titleEn ?? p.titleBn}>
  <div class="wrap" style="padding:1rem var(--dw-s-4) 2rem;max-width:760px">
    <h1><Bi bn={p.titleBn} en={p.titleEn ?? p.titleBn} /></h1>
    {bn.map((para, i) => <p><Bi bn={para} en={en[i] ?? para} /></p>)}
  </div>
</Base>
