---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Bi from '../components/Bi.astro';
import CatalogBrowser from '../components/CatalogBrowser.astro';
---
<Base titleBn="হোম" titleEn="Home" nav="home">
  <Hero />
  <div class="wrap">
    <div class="below"><CatalogBrowser /></div>

    <section class="s below">
      <div class="card promo">
        <div style="flex:1;min-width:240px">
          <h2 style="font-size:1.2rem;margin-bottom:.3rem"><Bi k="showroom" /></h2>
          <p class="muted" style="margin:0" data-bulkpromo><Bi bn="অনুষ্ঠান বা বড় চাহিদার জন্য একসাথে অনেক পণ্য অর্ডার করুন। আপনার পছন্দের শাখা থেকে সংগ্রহ করুন।" en="Ordering a lot for an event or a big need? Collect from the branch you choose." /></p>
        </div>
        <a class="btn primary" href="/showroom"><Bi bn="শোরুম থেকে অর্ডার করুন" en="Order from showroom" /></a>
      </div>
    </section>

    <section class="s below" style="padding-top:0">
      <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr))">
        <a class="card" href="/about" style="display:block;padding:1.1rem;color:inherit"><h2 style="font-size:1.05rem;margin:0"><Bi bn="দুধওয়ালা সম্পর্কে" en="About Dudhwala" /></h2><p class="muted" style="margin:0;font-size:.9rem"><Bi bn="আমাদের পরিচিতি →" en="Who we are →" /></p></a>
        <a class="card" href="/track" style="display:block;padding:1.1rem;color:inherit"><h2 style="font-size:1.05rem;margin:0"><Bi k="track" /></h2><p class="muted" style="margin:0;font-size:.9rem"><Bi bn="অর্ডার নম্বর ও ফোন দিয়ে →" en="With order number and phone →" /></p></a>
      </div>
    </section>
  </div>
  <script>
    import { getConfig } from '../lib/api';
    import { toBn } from '../scripts/bn';
    getConfig().then((c) => {
      const bp = document.querySelector('[data-bulkpromo]');
      if (bp) bp.innerHTML = `<span class="bn">অনুষ্ঠান বা বড় চাহিদার জন্য একসাথে অনেক পণ্য অর্ডার করুন। ন্যূনতম${c.bulk.approved === false ? ' (চূড়ান্ত নয়)' : ''}: ${toBn(String(c.bulk.min_total_quantity))} টি। আপনার পছন্দের শাখা থেকে সংগ্রহ করুন।</span><span class="en">Ordering a lot for an event or a big need? Minimum${c.bulk.approved === false ? ' (not final)' : ''}: ${c.bulk.min_total_quantity} items. Collect from the branch you choose.</span>`;
    });
  </script>
</Base>
