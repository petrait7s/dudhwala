---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Bi from '../components/Bi.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../lib/catalogue';
const featured = products.filter((_, i) => i % 7 === 0).slice(0, 8);
---
<Base titleBn="হোম" titleEn="Home" nav="home">
  <Hero />
  <div class="wrap">
    <div class="bento">
      <div class="card b"><strong><Bi bn="অর্ডারের সময়" en="Ordering hours" /></strong><span class="muted" data-hours>১০:০০ – ২২:০০</span></div>
      <div class="card b"><strong><Bi bn="ডেলিভারি" en="Delivery" /></strong><span class="muted"><Bi bn="ইন সিলেট: ২৪ ঘণ্টার মধ্যে · আউটার সিলেট: ২৪–৪৮ ঘণ্টা" en="In Sylhet: within 24h · Outer Sylhet: 24–48h" /></span></div>
      <div class="card b"><strong><Bi k="showroom" /></strong><span class="muted"><Bi bn="মদিনা মার্কেট শাখা থেকে সংগ্রহ" en="Collect at Modina Market Branch" /></span></div>
      <div class="card b"><strong><Bi bn="পেমেন্ট" en="Payment" /></strong><span class="muted"><Bi bn="ক্যাশ অন ডেলিভারি, বিকাশ, নগদ" en="Cash on delivery, bKash, Nagad" /></span></div>
    </div>

    <section class="s below">
      <h2><Bi bn="আমাদের পণ্য" en="Our products" /></h2>
      <div class="grid" id="grid">
        {featured.map((p) => <ProductCard slug={p.id} nameBn={p.nameBn} nameEn={p.nameEn} category={p.category} />)}
      </div>
      <p style="margin-top:1.2rem"><a class="btn primary" href="/shop"><Bi k="allProducts" /></a></p>
    </section>

    <section class="s below">
      <h2><Bi bn="কীভাবে অর্ডার করবেন" en="How to order" /></h2>
      <ol class="steps">
        <li class="card"><strong><Bi bn="পণ্য বাছুন" en="Pick products" /></strong><br /><span class="muted"><Bi bn="শপ থেকে পছন্দের পণ্য কার্টে যোগ করুন।" en="Add what you like from the shop to your cart." /></span></li>
        <li class="card"><strong><Bi bn="কীভাবে পাবেন ঠিক করুন" en="Choose how to get it" /></strong><br /><span class="muted"><Bi bn="হোম ডেলিভারি, এক্সপ্রেস পিকআপ, অথবা শোরুম।" en="Home delivery, express pickup, or showroom." /></span></li>
        <li class="card"><strong><Bi bn="পেমেন্ট" en="Pay" /></strong><br /><span class="muted"><Bi bn="ক্যাশ অন ডেলিভারি, অথবা বিকাশ/নগদে পাঠিয়ে TrxID দিন।" en="Cash on delivery, or send via bKash/Nagad and enter the TrxID." /></span></li>
        <li class="card"><strong><Bi bn="ট্র্যাক করুন" en="Track it" /></strong><br /><span class="muted"><Bi bn="অর্ডার নম্বর ও ফোন নম্বর দিয়ে অবস্থা দেখুন।" en="Use your order number and phone to see its status." /></span></li>
      </ol>
    </section>

    <section class="s below">
      <div class="cta">
        <h2><Bi bn="আজই অর্ডার করুন" en="Order today" /></h2>
        <p><Bi bn="অনেক পরিমাণে দরকার? শোরুম অর্ডারে সংগ্রহ করুন।" en="Need a large quantity? Order from the showroom." /></p>
        <a class="btn accent" href="/shop"><Bi k="shop" /></a>
      </div>
    </section>
  </div>
  <script>
    import { fillPrices } from '../scripts/prices';
    import { getConfig } from '../lib/api';
    import { hhmm } from '../lib/rules';
    import { toBn } from '../scripts/bn';
    fillPrices();
    getConfig().then((c) => {
      const el = document.querySelector('[data-hours]');
      if (el) { const t = `${hhmm(c.hours.open_minute)} – ${hhmm(c.hours.close_minute)}`; el.innerHTML = `<span class="bn">${toBn(t)}</span><span class="en">${t}</span>`; }
    });
  </script>
</Base>
