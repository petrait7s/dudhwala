---
import Base from '../layouts/Base.astro';
import Bi from '../components/Bi.astro';
import site from '../data/site.json';
import about from '../data/about.json';
import { categories, products } from '../lib/catalogue';
const count = (slug: string) => products.filter((p) => p.category === slug).length;
---
<Base titleBn="আমাদের সম্পর্কে" titleEn="About us" nav="info" zonebar={false}>
  <div slot="band" class="zonebar try-band">
    <div class="wrap zb">
      <span class="tb-t"><Bi bn="আমাদের পণ্য একবার চেখে দেখুন" en="Try our products" /></span>
      <div class="zb-r">
        <a class="zb-act" href="/shop"><Bi bn="এখনই অর্ডার করুন" en="Order now" /></a>
        <a class="zb-about" href="/shop"><Bi bn="পণ্য দেখুন" en="Browse products" /></a>
      </div>
    </div>
  </div>
  <section class="ab-hero">
    <div class="wrap">
      <span class="ab-plate"><img src="/logo.png" width="120" height="64" alt={site.nameEn} class="ab-logo" /></span>
      <p class="ab-eyebrow"><Bi bn={site.taglineBn} en={site.taglineEn} /></p>
      <h1><Bi bn={`${site.nameBn}: সিলেটের খাঁটি দুগ্ধজাত স্বাদ`} en={`${site.nameEn}: pure dairy taste of Sylhet`} /></h1>
    </div>
  </section>

  <div class="wrap ab">
    <section class="ab-story card">
      <h2><Bi bn="আমাদের গল্প" en="Our story" /></h2>
      {about.storyBn.map((t, i) => <p><Bi bn={t} en={about.storyEn[i] ?? t} /></p>)}
    </section>

    <section>
      <h2><Bi bn="আমরা কী কথা দিই" en="What we promise" /></h2>
      <div class="ab-grid">
        {about.promises.map((p) => <div class="card ab-p"><h3><Bi bn={p.bn} en={p.en} /></h3><p class="muted"><Bi bn={p.bnText} en={p.enText} /></p></div>)}
      </div>
    </section>

    <section>
      <h2><Bi bn="আমরা যা তৈরি করি" en="What we make" /></h2>
      <div class="ab-grid">
        {categories.map((c) => <a class="card ab-p" href={`/category/${c.slug}`} style="color:inherit"><h3><Bi bn={c.nameBn} en={c.nameEn} /></h3><p class="muted"><Bi bn={`${count(c.slug)}টি পণ্য →`} en={`${count(c.slug)} products →`} /></p></a>)}
      </div>
    </section>

    <section>
      <h2><Bi bn="কীভাবে পাবেন" en="How to get it" /></h2>
      <div class="ab-grid">
        <div class="card ab-p"><h3><Bi bn="ঘরে ডেলিভারি" en="Home delivery" /></h3><p class="muted"><Bi bn="সিলেট শহরের ভেতরে ও বাইরে। কুরিয়ার বা রাইডারে পৌঁছে যায়।" en="Inside and outside Sylhet city, by courier or rider." /></p></div>
        <div class="card ab-p"><h3><Bi bn="এক্সপ্রেস পিকআপ" en="Express pickup" /></h3><p class="muted"><Bi bn="অর্ডার করে পছন্দের শাখা থেকে নিয়ে নিন।" en="Order ahead and collect from the branch you pick." /></p></div>
        <div class="card ab-p"><h3><Bi bn="শোরুম / বাল্ক অর্ডার" en="Showroom / bulk" /></h3><p class="muted"><Bi bn="অনুষ্ঠান বা বড় চাহিদার জন্য, যেকোনো শাখা থেকে সংগ্রহ।" en="For events or big needs, collect from any branch." /></p></div>
        <div class="card ab-p"><h3><Bi bn="পেমেন্ট" en="Payment" /></h3><p class="muted"><Bi bn="ক্যাশ অন ডেলিভারি, বিকাশ বা নগদ।" en="Cash on delivery, bKash or Nagad." /></p></div>
      </div>
    </section>

    <section>
      <div id="branches" data-brand></div>
    </section>

    <p class="ab-cta"><a class="btn primary" href="/shop"><Bi k="shop" /></a> <a class="btn" href="/track"><Bi k="track" /></a> <a class="btn" href="/contact"><Bi k="contact" /></a></p>
  </div>
  <script>import '../scripts/branches';</script>
</Base>
