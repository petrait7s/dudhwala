---
import Base from '../layouts/Base.astro';
import Bi from '../components/Bi.astro';
import { products, categories } from '../lib/catalogue';
import site from '../data/site.json';
---
<Base titleBn="শোরুম থেকে অর্ডার" titleEn="Order From Showroom">
  <div class="wrap" style="padding:1rem var(--dw-s-4) 2rem">
    <h1><Bi k="showroom" /></h1>
    <p class="notice" role="note"><Bi
      bn={`পণ্য বেছে সংখ্যা দিন। সংগ্রহ শুধু ${site.showroom.nameBn} থেকে; হোম ডেলিভারি নেই। আগে পেমেন্ট লাগে।`}
      en={`Pick products and quantities. Collection only at ${site.showroom.nameEn}; no home delivery. Payment is required in advance.`} /></p>
    <p class="muted" id="limit"></p>
    <p class="notice warn" id="noapi" hidden><Bi bn="অনলাইন অর্ডার এখনো চালু হয়নি। শীঘ্রই আসছে।" en="Online ordering is not open yet. Coming soon." /></p>

    <div class="field" style="max-width:420px;margin-top:1rem">
      <label for="bq"><Bi bn="খুঁজুন" en="Search" /></label>
      <input id="bq" type="search" data-ph-bn="দই, সন্দেশ, কেক…" data-ph-en="doi, sandesh, cake…" placeholder="দই, সন্দেশ, কেক…" />
    </div>

    {categories.map((c) => (
      <section style="margin-top:1.4rem" data-cat={c.slug}>
        <h2 style="font-size:1.2rem"><Bi bn={c.nameBn} en={c.nameEn} /></h2>
        <ul class="bulk-list">
          {products.filter((p) => p.category === c.slug).map((p) => (
            <li class="bulk-row" data-slug={p.id} data-name={`${p.nameBn} ${p.nameEn}`.toLowerCase()} data-cat={c.slug}>
              <span class="nm"><Bi bn={p.nameBn} en={p.nameEn} /> <small class="muted" data-note></small></span>
              <div class="qty sm" role="group">
                <button type="button" data-d="-1" aria-label="−">−</button>
                <input class="bulk-qty" inputmode="numeric" placeholder="0" aria-label="Quantity" />
                <button type="button" data-d="1" aria-label="+">+</button>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <p id="none" class="notice" hidden><Bi k="noResults" /></p>

    <div class="actbar" role="region" aria-label="Showroom order summary">
      <p style="margin:0" id="sum"></p>
      <span class="err" id="err" role="alert"></span>
      <button class="btn primary" type="button" id="go" disabled><Bi bn="চেকআউটে যান" en="Go to checkout" /></button>
    </div>
  </div>
  <script>import '../scripts/showroom';</script>
</Base>
