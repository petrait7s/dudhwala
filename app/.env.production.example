# Production template for the cPanel host. Copy to .env on the server and fill in.
APP_NAME=Dudhwala
APP_ENV=production
APP_KEY=                      # php artisan key:generate --force
APP_DEBUG=false
APP_URL=https://admin.example.com
APP_TIMEZONE=UTC
APP_LOCALE=bn
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql           # or mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Argon2id when PHP has it (php -r 'var_dump(defined("PASSWORD_ARGON2ID"));'), else bcrypt
HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Storefront origin(s) allowed to call /api (comma separated, no trailing slash)
CORS_ALLOWED_ORIGINS=https://www.example.com

# Only if mysqldump is not on PATH on the host
# DB_DUMP_BINARY=/usr/bin/mysqldump
